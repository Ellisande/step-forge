{
  "name": "@step-forge/step-forge",
  "version": "0.0.20",
  "module": "./dist/step-forge.js",
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/step-forge.d.cts",
        "default": "./dist/step-forge.cjs"
      },
      "import": {
        "types": "./dist/step-forge.d.ts",
        "default": "./dist/step-forge.js"
      }
    },
    "./analyzer": {
      "types": "./dist/analyzer.d.ts",
      "import": "./dist/analyzer.js"
    },
    "./runtime": {
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      },
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./dist/": {
      "import": "./dist/"
    }
  },
  "bin": {
    "step-forge-analyze": "./dist/analyzer-cli.js"
  },
  "types": "./dist/step-forge.d.ts",
  "scripts": {
    "build": "rm -rf build && tsc --noEmit && tsdown && cp package.json README.md LICENSE.md CHANGELOG.md build/",
    "test": "vitest run",
    "test:unit": "bun test src/runtime",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:debug": "vitest run --reporter=verbose",
    "lint": "eslint . --ext .ts",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "earl": "^1.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "^18.1.0",
    "@cucumber/gherkin": "^37.0.1",
    "@cucumber/messages": "^24.1.0",
    "lodash": "^4.17.21"
  }
}
